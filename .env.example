# E2B: API Keys tab of the E2B dashboard, https://e2b.dev/dashboard?tab=keys (SDK README)
E2B_API_KEY=
# Daytona: a project API key, minted in the Daytona dashboard (SDK README)
DAYTONA_API_KEY=
# Sprites: see dashboard (the SDK README also documents SpritesClient.createToken(flyMacaroon, orgSlug))
SPRITES_TOKEN=
# Modal: see dashboard (the SDK README names `pip install modal && modal setup` as the CLI sign-in)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Vercel: token from account settings > Tokens, scoped to the team; team ID from team settings; project ID from project settings (SDK README)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Baseten: API keys page of the Baseten dashboard (Organization settings > API keys)
BASETEN_API_KEY=
